# ===== Aplicación =====
APP_NAME=CMSS-Biomedico
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# ===== Base de datos (PostgreSQL) =====
POSTGRES_USER=cmss
POSTGRES_PASSWORD=changeme
POSTGRES_DB=cmss_biomedico
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Cadena usada por SQLAlchemy/Alembic
DATABASE_URL=postgresql+psycopg://cmss:changeme@localhost:5432/cmss_biomedico

# ===== Seguridad / JWT (RNF-002) =====
SECRET_KEY=cambiar-esta-clave-por-una-larga-y-aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# ===== CORS =====
BACKEND_CORS_ORIGINS=http://localhost:5173

# ===== Correo (alertas — opcional en v1) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=alertas@cmss-biomedico.local

# ===== Almacenamiento de archivos (RF-010 documentos adjuntos) =====
STORAGE_DIR=./uploads

# ===== Frontend =====
VITE_API_BASE_URL=http://localhost:8000/api/v1
